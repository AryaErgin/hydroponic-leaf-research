# Documentation template only: the application does NOT automatically load .env.
# Set these explicitly in your shell as shown in docs/DEVELOPMENT.md.
# Development only. Production configuration and credentials are not distributed;
# the existing production guards require separately approved configuration.
# REQUIRED for local app/bootstrap/tests; nonsecret loopback address:
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# OPTIONAL: required only for durable Firestore integration tests; nonsecret:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8791
# REQUIRED for the Auth emulator launcher; nonsecret machine-specific path:
HYDRO_FIREBASE_TOOLS_ROOT=<absolute-repository-path>/.runtime/firebase-tools/node_modules/firebase-tools
# OPTIONAL SECRET bootstrap input. Prefer getpass; never commit a real value.
HYDRO_DEMO_PASSWORD=<choose-a-unique-local-synthetic-password-at-least-15-characters>
