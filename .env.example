# OPTIONAL reference. setup.ps1/start.ps1 need NO .env or production secrets.
# No dotenv loader reads this file. Never enter real values here.
# QA-only first-owner inputs; prefer hidden interactive prompts:
# HYDRO_LOCAL_OWNER_EMAIL=your-local-owner@example.test
# HYDRO_LOCAL_OWNER_PASSWORD=<unique-local-password-at-least-15-characters>
# Test-only installed package path, nonsecret:
# HYDRO_TEST_FIREBASE_TOOLS_ROOT=<repository>/.runtime/firebase-tools/node_modules/firebase-tools
# Optional Firestore tests only; not used by normal local setup:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8791
